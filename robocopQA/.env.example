# ══════════════════════════════════════════════
# RoboCop QA — Configuração
# Copie este arquivo para .env e preencha
# ══════════════════════════════════════════════


# ─── LLM (usado pelo RoboCop e pelo Ultron) ──
# Provedor: anthropic | openai | gemini | groq | ollama
LLM_PROVIDER=anthropic

# Modelo (deixe em branco para usar o padrão do provedor)
# Anthropic padrão : claude-opus-4-5
# OpenAI padrão    : gpt-4o
# Gemini padrão    : gemini/gemini-1.5-pro
# Groq padrão      : groq/llama-3.1-70b-versatile
# Ollama padrão    : ollama/llama3
LLM_MODEL=

# Chave de API — preencha apenas a do provedor escolhido
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Ollama roda localmente, sem chave


# ─── Configurações do browser (RoboCop) ──────
# false = abre janela do browser (útil para debug)
BROWSER_HEADLESS=true
CAPTURE_SCREENSHOTS=true


# ─── GitHub (Ultron) ─────────────────────────
# Personal Access Token — permissões necessárias: repo (leitura)
# Crie em: github.com/settings/tokens
GITHUB_TOKEN=
# Repositório no formato org/repo (ex: minha-empresa/backend-api)
GITHUB_REPO=


# ─── Gerenciador de tarefas (Ultron) ─────────
# Provedor: jira | linear | github
PM_PROVIDER=github

# ── Jira (preencha se PM_PROVIDER=jira) ──────
JIRA_BASE_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=seu@email.com
# Crie o token em: id.atlassian.net/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# ── Linear (preencha se PM_PROVIDER=linear) ──
# Crie em: linear.app/settings/api
LINEAR_API_KEY=

# ── GitHub Issues: usa o GITHUB_TOKEN acima ──
