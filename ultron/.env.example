# ══════════════════════════════════════════════
# Ultron QA — Configuração
# Copie para .env e preencha
# ══════════════════════════════════════════════

# ─── LLM ─────────────────────────────────────
# anthropic | openai | gemini | groq | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── GitHub ───────────────────────────────────
# Token com permissão de leitura em repos (repo:read)
# Crie em: github.com/settings/tokens
GITHUB_TOKEN=
# Formato: org/repositorio  (ex: minha-empresa/backend-api)
GITHUB_REPO=

# ─── Gerenciador de tarefas ───────────────────
# jira | linear | github | huly
PM_PROVIDER=github

# Jira
JIRA_BASE_URL=https://suaempresa.atlassian.net
JIRA_EMAIL=seu@email.com
# Crie em: id.atlassian.net/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Linear
# Crie em: linear.app/settings/api
LINEAR_API_KEY=

# GitHub Issues: usa o GITHUB_TOKEN acima, sem configuração extra

# Huly (via agente ultron-qa + MCP — o Python não fala com o Huly direto)
# O agente busca o card via MCP (get_issue) e grava este JSON {title, description, url}:
HULY_CARD_FILE=
# Onde gravar o comentário gerado (padrão: qa-docs/<CARD>/ultron-comment.md).
# O agente publica esse conteúdo no card via MCP add_comment.
HULY_COMMENT_OUT=
